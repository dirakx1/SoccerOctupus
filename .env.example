# ── Zep Cloud knowledge graph (mirrors MiroFish) ───────────────────────────
# Free monthly quota at https://app.getzep.com/ is sufficient.
# 1. Create a free account and copy your API key below.
# 2. Leave ZEP_GRAPH_ID empty on first run — the /api/predictions/graph/build
#    endpoint will create the graph and print its ID; paste that ID here so
#    future runs reuse the same graph instead of rebuilding.
ZEP_API_KEY=your_zep_api_key
ZEP_GRAPH_ID=

# ── LLM (OpenAI-compatible endpoint) ───────────────────────────────────────
# Any OpenAI-format provider works (GPT-4o, Claude via proxy, Qwen, etc.)
LLM_API_KEY=your_openai_or_compatible_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# ── Opta / Stats Perform API ───────────────────────────────────────────────
# Commercial license required: https://developer.statsperform.com/
# Without this key the SquadQualityAgent uses a derived model calibrated
# against published Opta national-team benchmarks (still adds real signal).
OPTA_API_KEY=

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Optional — without it the VideoAgent uses synthetic engagement scores.
# Free quota: 10,000 units/day → ~1,000 video searches.
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5002
DEBUG=false

# ── Swarm tuning ───────────────────────────────────────────────────────────
SWARM_PARALLEL_AGENTS=7
SWARM_TIMEOUT_SECONDS=60
MC_SIMULATIONS=10000
